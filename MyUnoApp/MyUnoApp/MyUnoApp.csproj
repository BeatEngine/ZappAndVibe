<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-browserwasm;net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>zappnvibe</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.beatengine.zappnvibe</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>beatengine</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Zapp and Vibe makes dating easy.</Description>

    <AndroidLinkMode>SdkAndUserAssemblies</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <PublishTrimmed>true</PublishTrimmed>
  
    <TrimMode>partial</TrimMode> 
    

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\user.png" />
        <Content Include="Assets\heart.png" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" />
      <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

  <!-- 2. Spezieller Block NUR für Android -->
  <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
      <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
      <TargetSdkVersion>33</TargetSdkVersion>
  </PropertyGroup>

    <Target Name="Copyapk" AfterTargets="_CopyPackage">
        <PropertyGroup>
            <SourceApk>$(OutputPath)com.beatengine.zappnvibe-Signed.apk</SourceApk>
            <NetworkDest>T:\com.beatengine.zappnvibe-Signed.apk</NetworkDest>
        </PropertyGroup>
        <Message Text="Copy apk to networkfolder" Importance="high" />
        <Exec Command="powershell -ExecutionPolicy Bypass -Command &quot;Start-Process powershell -ArgumentList '-ExecutionPolicy Bypass -Command &quot;&quot;Start-Sleep -Seconds 5; Copy-Item -Path \&quot;$(SourceApk)\&quot; -Destination \&quot;$(NetworkDest)\&quot; -Force&quot;&quot;' -WindowStyle Hidden&quot;" ContinueOnError="true" />
    </Target>

</Project>
