<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-browserwasm;net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>zappnvibe</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.beatengine.zappnvibe</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>beatengine</ApplicationPublisher>
    <!-- Package Description -->
    <Description>MyUnoApp powered by Uno Platform.</Description>

    <AndroidLinkMode>SdkAndUserAssemblies</AndroidLinkMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <PublishTrimmed>true</PublishTrimmed>
  
    <TrimMode>partial</TrimMode> 
    

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
